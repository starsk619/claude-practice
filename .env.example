# Google Gemini API (summarizer, analyst 모듈에서 사용) - 무료 티어로 발급 가능
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# Slack Incoming Webhook (선택) - 텍스트 다이제스트 발송용
SLACK_WEBHOOK_URL=

# Slack 파일 첨부용 (선택, 둘 다 있어야 동작) - Incoming Webhook은 파일 업로드를 지원하지 않아서
# HTML 리포트를 Slack에 실제로 첨부하려면 Bot Token 방식이 별도로 필요함. 없으면 텍스트로만 안내됨.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Telegram Bot (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 카카오톡 "나에게 보내기" (선택) - developers.kakao.com에서 앱 생성 후
# node scripts/kakao-auth.js 로 1회 인증하면 KAKAO_REFRESH_TOKEN을 얻을 수 있음
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback
KAKAO_REFRESH_TOKEN=

# 리포트 공개 링크 (선택) - 카카오톡처럼 파일 첨부가 안 되는 채널에 대신 이 링크를 보냄.
# GitHub Pages에 reports/daily-briefing.html을 배포했을 때의 주소 (docs/kakao-setup.md 참고)
REPORT_PUBLIC_URL=https://starsk619.github.io/claude-practice/reports/daily-briefing.html

# 실행 스케줄 (cron 표현식, 기본: 매일 오전 8시)
CRON_SCHEDULE=0 8 * * *

# RSS 소스 (콤마로 구분, 비우면 기본 소스 사용)
NEWS_RSS_FEEDS=
